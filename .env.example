# Optional server-side NFT indexer endpoint.
# It must return { "tokenIds": ["123", "456"] } or a supported collection/items shape
# for GET ?owner=0x... and must filter to the Chog Genesis contract.
# Do not place a private provider/indexer API key in a VITE_* variable.
VITE_CHOG_NFT_INDEXER_URL=
VITE_MONAD_RPC_URL=https://rpc.monad.xyz
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Local dev only: copy this file to .env.local, then set the key there. .env.local is git-ignored.
# For deployment, set OPENSEA_API_KEY as a server-side secret on Vercel or Cloudflare Pages.
# Never name this VITE_OPENSEA_API_KEY; never commit the real key.
# OPENSEA_API_KEY=
