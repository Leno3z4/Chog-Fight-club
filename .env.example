# Optional server-side NFT indexer endpoint.
# It must return { "tokenIds": ["123", "456"] } or a supported collection/items shape
# for GET ?owner=0x... and must filter to the Chog Genesis contract.
# Do not place a private provider/indexer API key in a VITE_* variable.
VITE_CHOG_NFT_INDEXER_URL=
VITE_MONAD_RPC_URL=https://rpc.monad.xyz
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Local dev only: copy this file to .env.local, then set the key there. .env.local is git-ignored.
# For deployment, set OPENSEA_API_KEY as a server-side secret on Vercel or Cloudflare Pages.
# Never name this VITE_OPENSEA_API_KEY; never commit the real key.
# OPENSEA_API_KEY=

# Discord OAuth — server-side only; never prefix secrets with VITE_
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=1253481714710220810
DISCORD_HOLDER_ROLE_ID=1545507860455096460
# Must exactly match the callback registered in the Discord Developer Portal.
DISCORD_REDIRECT_URI=http://localhost:5173/api/discord/callback
# Generate a long random secret (for example: openssl rand -base64 32).
SESSION_SECRET=
# Optional local origin override:
DISCORD_APP_ORIGIN=http://localhost:5173

# Cloudflare Pages: bind a D1 database in Settings > Bindings with variable name CHOG_DB.
# Apply migrations/0001_challenge_invites.sql to that D1 database with Wrangler.
# D1 bindings are provided by Cloudflare at runtime; do not put a database ID or secret here.
# Server-side Monad RPC used to verify Chog ownership before invite actions.
MONAD_RPC_URL=https://rpc.monad.xyz

# Set on Vercel: deployed Cloudflare Pages backend base URL (server-side only).
CLOUDFLARE_BACKEND_URL=https://chog-fight-club.pages.dev

# Pact factory integration. Set PACT_FACTORY_ADDRESS only after deployment and end-to-end verification.
PACT_FACTORY_ADDRESS=
PACT_CHAIN_ID=143

# Resolver must be the same address passed to the factory constructor. Store the private key only as a Cloudflare secret.
PACT_RESOLVER_ADDRESS=
# PACT_RESOLVER_PRIVATE_KEY=  # Cloudflare secret only; never commit or expose to the browser

# Public base URL of the Cloudflare realtime Worker (not a secret). Set on Vercel and redeploy the frontend.
# VITE_ARENA_REALTIME_URL=https://chog-battle-arena-realtime.<your-account>.workers.dev
